# Dependencies
node_modules/

# Build output. `package.json#files` publishes these from a fresh build; they are
# not source and must never be committed.
lib/
*.tsbuildinfo

# Probe build output, regenerated by `tsdown.probe.config.ts`.
_probe/

# 审计仪器的产物目录，由 `tsdown.audit.config.ts` 与 `_audit/analyze.mjs` 重新生成
# （读数在 `docs/审计-GFM覆盖-实测.md` §9 有复现命令）。
_audit/

# Vault fixtures. `scripts/probe-vault.mjs` recreates both on every run, and the
# containment check only means something when the second one sits OUTSIDE the
# authorized root.
_vault-probe/
_outside-probe/

# Research scratch from delegated investigations. Large, throwaway, and never
# referenced by the plugin.
_dsh_probe/
_research/

# Package tarballs unpacked to read an upstream implementation before adopting it
# (GFM §6.9, 2026: the two autolink-literal packages). Throwaway by definition —
# once they are real dependencies they live in `node_modules/`. `*.tgz` below
# covers the archives; this covers what they expand to.
_autolink-probe/

# Packed packages
*.tgz

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 提交信息用文件传给 git 时会写在这里（见 docs/Git操作手册.md 第一节）。
# 忽略它是为了"万一忘了删"也不会被顺手提交进去。
.commit-msg.txt

# 内部文档：需求、方案、计划、审计、决策记录、发布手册与平台建议。
# 它们**不进 git**（GitHub 只看到 public-docs/），靠 scripts/docs-backup.mjs 备份到仓库外。
# 警告：`git clean -xfd` 会连它一起删掉 —— 这个仓库不要跑那条命令。
docs/
