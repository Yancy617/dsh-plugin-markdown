{
  "name": "@yancy617/dsh-plugin-markdown",
  "version": "0.2.0",
  "description": "Markdown editor for DeepSeek Harness — edit a directory of .md files with a Feishu-grade editing experience",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yancy617/dsh-plugin-markdown.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "markdown",
    "editor",
    "notes"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "_vault-test",
    "_vault-test/.img"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "env:check": "node scripts/env-check.mjs",
    "verify:map": "node scripts/verify-map.mjs",
    "docs:public": "node scripts/docs-public.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:backup": "node scripts/docs-backup.mjs",
    "probe:block": "tsdown --config tsdown.block.config.ts && node _probe/probe-block.mjs",
    "probe:units": "tsdown --config tsdown.block.config.ts && node _probe/probe-units.mjs",
    "probe:syntax": "tsdown --config tsdown.block.config.ts && node _probe/probe-syntax.mjs",
    "probe:lexical": "tsdown --config tsdown.block.config.ts && node _probe/probe-lexical.mjs",
    "pretest": "tsdown",
    "test": "tsdown --config tsdown.block.config.ts && node _probe/probe-block.mjs && node _probe/probe-units.mjs && node _probe/probe-syntax.mjs && node _probe/probe-lexical.mjs && node scripts/docs-check.mjs",
    "prepack": "tsdown"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-files": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "26.6.3",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-gfm-autolink-literal": "^2.0.1",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "mdast-util-to-markdown": "^2.2.0",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@lexical/clipboard": "^0.49.0",
    "@lexical/code-core": "^0.49.0",
    "@lexical/headless": "^0.49.0",
    "@lexical/history": "^0.49.0",
    "@lexical/html": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@lexical/table": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "lexical": "^0.49.0"
  }
}
